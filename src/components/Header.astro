---
// src/components/Header.astro
import type { Lang } from '@/lib/i18n';
import brandLogo from '@/assets/jodaz.png';
import HeaderInteractive from '@/components/HeaderInteractive.tsx';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

// Site standard: no trailing slashes (home stays '/').
const path = Astro.url.pathname.replace(/\/+$/, '');
const altLangHref = lang === 'es' ? path.replace(/^\/es/, '') || '/' : `/es${path}`;
---

<HeaderInteractive
  logoSrc={brandLogo.src}
  lang={lang}
  altLangHref={altLangHref}
  client:load
/>
