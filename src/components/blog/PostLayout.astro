---
// src/components/blog/PostLayout.astro
// Single post: a reading column of roughly 68ch, an uppercase display title,
// a date / reading-time / tags meta line, a back link, and the rendered body.
import type { Lang } from '@/lib/i18n';
import { useTranslations } from '@/lib/i18n';
import { blogHref, readingTime, type BlogPost } from '@/lib/blog';

interface Props {
  post: BlogPost;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'es' ? 'es-ES' : 'en-US';

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(locale, {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const readLabel = t('blog.readingTime').replace('{n}', String(readingTime(post.body)));
const updatedLabel = post.data.updatedDate
  ? t('blog.updated').replace('{date}', formatDate(post.data.updatedDate))
  : null;

const { Content } = await post.render();
---

<article class="container mx-auto px-4 pb-24 pt-28 md:pt-36">
  <div class="mx-auto w-full max-w-[68ch]">
    <a
      href={blogHref(lang)}
      class="group inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-muted-foreground transition-colors hover:text-primary"
    >
      <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
      {t('blog.backToIndex')}
    </a>

    <header class="mt-10 border-b-2 border-foreground/20 pb-8">
      <h1 class="text-4xl font-bold uppercase leading-none tracking-tight text-foreground md:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs uppercase tracking-[0.15em] text-muted-foreground">
        <time datetime={post.data.publishDate.toISOString()}>
          {formatDate(post.data.publishDate)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readLabel}</span>
        {post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.data.tags.join(' · ')}</span>
          </>
        )}
      </p>
      {updatedLabel && (
        <p class="mt-3 text-xs uppercase tracking-[0.15em] text-muted-foreground">
          {updatedLabel}
        </p>
      )}
    </header>

    <div
      class="prose-project mt-10 prose-code:before:content-none prose-code:after:content-none [&_:not(pre)>code]:rounded-none [&_:not(pre)>code]:bg-muted [&_:not(pre)>code]:px-1 [&_:not(pre)>code]:font-sans [&_:not(pre)>code]:font-normal"
    >
      <Content />
    </div>
  </div>
</article>
