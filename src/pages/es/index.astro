---
// src/pages/es/index.astro — Home page (Spanish locale)
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/lib/i18n';
import HeroIsland from '@/components/islands/HeroIsland';
import StructuredData from '@/components/StructuredData.astro';
import { getAiUsageProps } from '@/lib/ai-usage-props';
import { PROFILE_SOCIALS } from '@/lib/links';
import founder from '@/assets/images/founder.jpeg';

const lang = 'es' as const;
const t = useTranslations(lang);

const heroProps = {
  name: t('profile.name'),
  role: t('profile.role'),
  bio: t('profile.bio'),
  photoSrc: founder.src,
  photoAlt: t('profile.photoLabel'),
  socials: PROFILE_SOCIALS,
  lang,
  tabs: { me: t('profile.tabMe'), ai: t('profile.tabAi') },
  usage: getAiUsageProps(lang),
};
---

<BaseLayout
  title={t('profile.metaTitle')}
  description={t('profile.metaDescription')}
  lang={lang}
  alternateUrl="https://jodaz.vanguarddevs.com"
>
  <StructuredData schemas={[{ type: 'person', lang: 'es' }]} />
  <HeroIsland {...heroProps} client:load />
</BaseLayout>
